# SAP Connection Settings
# For multi-instance deployments, set SAP_MCP_ENV_FILE in each process environment.
# It selects this file before dotenv loads, so do not define it inside the target file itself.
SAP_URL=https://example.sap-server.com:44300
SAP_USER=EXAMPLE_USER
SAP_PASSWORD=your_password_here
# Production recommendation: leave SAP_PASSWORD unset and configure an absolute
# helper path plus target. The helper receives the target as argv[1] and prints one line.
# SAP_MCP_CREDENTIAL_COMMAND=C:\\Program Files\\sap-secrets\\get-credential.exe
# SAP_MCP_CREDENTIAL_TARGET=sap-dev
SAP_CLIENT=100
SAP_LANGUAGE=EN

# Classic-RFC direct-link instance number (optional; read-only RFM tools only:
# probeRfcSystem/readRfcTable/describeRfm/callRfm behind the read-only allowlist).
# Connection host/client/credentials derive from the ADT settings above.
# Defaults to 01 when unset; set to the target system's actual instance number.
# RFC_SYSNR=01

# Focused is the developer-first default. Use business/operations for role-specific
# read-only work, or expert when a script needs the complete low-level ADT surface.
# The old profile names remain supported for compatibility.
# System role overrides profile: QAS/PRD/missing/unknown roles permit only local and read-only tools.
# focused | developer | business | operations | expert | safe | development |
# diagnostic-readonly | legacy-full | development-workbench | business-readonly | operations-readonly
SAP_MCP_TOOL_PROFILE=focused

# Source changes fail closed unless every boundary below is configured.
SAP_MCP_SYSTEM_ROLE=DEV
SAP_MCP_ALLOWED_HOSTS=example.sap-server.com
SAP_MCP_ALLOWED_CLIENTS=100
SAP_MCP_ALLOWED_NAMESPACES=Z,Y
SAP_MCP_CHANGE_PLAN_TTL_SECONDS=900
# Safe debug control is registered only by the development/development-workbench profile on DEV.
# Multiple SAP users are comma-separated. If unset, only SAP_USER is allowed.
SAP_MCP_ALLOWED_DEBUG_USERS=
SAP_MCP_DEBUG_AUTH_TTL_SECONDS=900
SAP_MCP_AUDIT_PATH=C:\sap-mcp-audit

# Guarded DDIC, package, and RAP changes are available only with development + DEV.
# Their preview is non-mutating; apply accepts a server plan ID and requires native form confirmation.
# Raw setters/execute/generate/publish exist only in DEV legacy-full and bypass those guarded workflows.

# Prefer native MCP form elicitation. Enable this weaker text fallback only for incompatible clients.
SAP_MCP_ALLOW_TEXT_CONFIRMATION=false
# Confirmation mode for controlled write chains (apply tools):
#   native (default) = every apply requires one manual native confirmation;
#   auto = skip the manual confirmation; apply executes in a single call.
# auto is a deployment-level pre-authorization that gives the AI full control of
# controlled writes. It is honored only with SAP_MCP_SYSTEM_ROLE=DEV; any other
# role fails at startup. Audit entries record confirmationMode=auto-config.
SAP_MCP_CONFIRMATION_MODE=native
# Controlled repository creation uses one fixed provider per Server session.
# auto prefers MCP form elicitation when the client supports it, then falls back to the trusted Windows desktop dialog on Windows.
# Ignored while SAP_MCP_CONFIRMATION_MODE=auto.
SAP_MCP_CONFIRMATION_PROVIDER=auto
# Default off. When enabled, only the listed object kinds and prefix may be real-DEV validated.
# Temporary per-kind exception for an explicitly authorized DEV validation run. Keep false otherwise.
# Capability writable remains false until creation, readback, transport evidence, and cleanup are complete.
SAP_MCP_REAL_DEV_VALIDATION=false
SAP_MCP_REAL_DEV_VALIDATION_OBJECTS=
SAP_MCP_REAL_DEV_VALIDATION_PREFIX=
SAP_MCP_REAL_DEV_VALIDATION_PACKAGE=
SAP_MCP_REAL_DEV_VALIDATION_TRANSPORT=

# Performance and resource guardrails. Startup fails when a value is outside its documented range.
SAP_MCP_ADT_TIMEOUT_MS=60000
# Tiered execution gate: write slot (stateful chains, serialized) and read slot
# (read-only tools on the stateless read-domain session, safe to run concurrently).
SAP_MCP_MAX_CONCURRENT_TOOLS=1
SAP_MCP_MAX_READ_CONCURRENT_TOOLS=2
SAP_MCP_MAX_QUEUED_TOOLS=50
SAP_MCP_QUERY_DEFAULT_ROWS=200
SAP_MCP_QUERY_MAX_ROWS=5000
SAP_MCP_SEARCH_DEFAULT_RESULTS=50
SAP_MCP_SEARCH_MAX_RESULTS=500
SAP_MCP_MAX_ARGUMENT_BYTES=5242880
SAP_MCP_MAX_RESPONSE_BYTES=10485760
SAP_MCP_SOURCE_CACHE_MAX_ENTRIES=20
SAP_MCP_SOURCE_CACHE_MAX_ITEM_BYTES=2097152
SAP_MCP_SOURCE_CACHE_TTL_SECONDS=900
SAP_MCP_CHANGE_PLAN_MAX_ENTRIES=100
SAP_MCP_ROLLBACK_FAILED_RETENTION_SECONDS=86400
SAP_MCP_LOG_LEVEL=warn

# Session resilience rollout switches. All are read once at process startup.
# SAP_MCP_STATELESS_READS must stay true when SAP_MCP_MAX_READ_CONCURRENT_TOOLS > 1:
# the read slot's safety depends on read-only tools running on the stateless clone.
SAP_MCP_SESSION_RECOVERY=true
SAP_MCP_STATELESS_READS=true
SAP_MCP_REQUIRE_EXTERNAL_CREDENTIAL=false

# Optional SM21 runtime-log reading uses the existing ADT HTTP session.
# Deploy and activate sap/adt-http/ZCL_MCP_SM21_ADT_HTTP.abap in SICF first.
# SM21 tools are available with development, diagnostic-readonly, legacy-full, and operations-readonly profiles.
SAP_MCP_SM21_TIMEZONE=UTC
SAP_MCP_SM21_MAX_WINDOW_HOURS=24
SAP_MCP_SM21_DEFAULT_PAGE_SIZE=100
SAP_MCP_SM21_MAX_PAGE_SIZE=500

# Release capability gating (M1, low-release adaptation for S/4HANA 1511/1610).
# Optional. When set (e.g. 751), tools whose minBasisRelease exceeds it are hidden
# from tools/list and rejected on dispatch (currently: the RAP generator surface).
# When absent, the server probes RFC_SYSTEM_INFO once (RFCSAPRL) and caches the
# result; if the RFC channel is unavailable the gate stays off and the catalog is
# unchanged. Valid forms: 750 / 7.51 / 755.
#SAP_MCP_BASIS_RELEASE=751
