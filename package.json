    "test:where-used-config-real-dev": "node ./scripts/where-used-config-real-dev-smoke.mjs",
    "test:usage-examples-real-dev": "node ./scripts/usage-examples-real-dev-smoke.mjs",
    "test:f1-textpool-real-dev": "node ./scripts/f1-textpool-focused-real-dev-smoke.mjs",
    "test:textpool-controlled-real-dev": "node ./scripts/textpool-controlled-real-dev-smoke.mjs",
    "test:execute-abap-real-dev": "node scripts/execute-abap-real-dev-smoke.mjs",
    "test:fm-payload-real-dev": "node scripts/fm-test-data-payload-real-dev-smoke.mjs",
    "test:git-bridge-real-dev": "node scripts/git-bridge-real-dev-smoke.mjs",
    "test:cluster-impact-real-dev": "node scripts/cluster-impact-real-dev-smoke.mjs",
    "test:report-real-dev": "node scripts/report-real-dev-smoke.mjs",
    "test:helper-rfc-real-dev": "node scripts/helper-rfc-real-dev-smoke.mjs",
    "test:import-real-dev": "node scripts/repository-import-real-dev-smoke.mjs"
  },
  "keywords": [
    "abap",
    "sap",
    "adt",
    "abap-ai-workbench",
    "mcp",
    "model-context-protocol"
  ],
  "author": "KylinYZ",
  "contributors": [
    "mario-andreschak (original upstream mcp-abap-abap-adt-api)"
