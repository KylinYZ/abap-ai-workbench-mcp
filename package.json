  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:sap-dev:readonly": "node ./scripts/sap-dev-readonly-smoke.mjs",
    "test:sap-dev:readonly:ttl": "node ./scripts/sap-dev-readonly-smoke.mjs --verify-ttl",
    "test:sap-dev:session-resilience": "node ./scripts/sap-session-resilience-smoke.mjs",
    "test:repository-productionization-runtime": "node ./scripts/repository-productionization-runtime-smoke.mjs",
