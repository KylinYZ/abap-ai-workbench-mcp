{
  "name": "abap-ai-workbench-mcp",
  "version": "0.9.2",
  "mcpName": "io.github.kylinyz/abap-ai-workbench-mcp",
  "main": "dist/index.js",
  "bin": {
    "abap-ai-workbench-mcp": "dist/index.js"
